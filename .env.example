# Banco de Dados (SQLite local por padrão ou PostgreSQL no Railway/Render)
DATABASE_URL=sqlite:///data/vigia_publico.db
VIGIA_DB_PATH=data/vigia_publico.db

# Configuração da API (para o Frontend Streamlit e Bot)
VIGIA_API_URL=http://localhost:8000

# SMTP (Envio semanal de alertas por e-mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alertas@vigiapublico.org.br
SMTP_PASSWORD=sua_senha_de_app_aqui
SMTP_FROM=Vigia Público SC <alertas@vigiapublico.org.br>
ALERT_RECIPIENTS=jornalista1@exemplo.com.br,redacao@exemplo.com.br

# Telegram Bot API
TELEGRAM_BOT_TOKEN=seu_token_do_botfather_aqui
TELEGRAM_CHAT_IDS=123456789

# Fontes de Dados Reais (Portal da Transparência SC, IBGE, Dados Abertos SC e BrasilAPI)
VIGIA_USAR_REDE=1
VIGIA_ANO_EXERCICIO=2026
# Limite de extratos detalhados na coleta incremental (0 = baixar 100% das ~4.290 emendas)
VIGIA_MAX_EMENDAS=250
TCE_SC_CSV_URL=
IBGE_AGREGADOS_URL=https://servicodados.ibge.gov.br/api/v3/agregados/6579/periodos/-1/variaveis/9324?localidades=N6[N3[42]]
BRASILAPI_CNPJ_URL=https://brasilapi.com.br/api/cnpj/v1
